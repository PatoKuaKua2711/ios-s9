+
+/* Bind the calling kernel thread to one cpu (if it exists) and move there; returns the cpu now on. */
+int sweet_bind_current_thread(int cpu);
+int
+sweet_bind_current_thread(int cpu)
+{
+	if (cpu >= 0 && cpu < MAX_SCHED_CPUS && processor_array[cpu] != PROCESSOR_NULL) {
+		thread_bind(processor_array[cpu]);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	return cpu_number();
+}
