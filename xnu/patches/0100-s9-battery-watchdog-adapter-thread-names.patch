+/*
+ * The adapter that powerd reads (AdapterDetails) for a measured S9 source:
+ * what the cable gives (5 V at the charger's input limit), gone unplugged.
+ */
+void
+SweetBattery::publishAdapter(bool external, unsigned inputMa)
+{
+	const OSSymbol *key = OSSymbol::withCString("AdapterDetails");
+	if (key == NULL) {
+		return;
+	}
+	if (!external) {
+		if (properties->getObject(key) != NULL) {
+			properties->removeObject(key);
+			removeProperty(key);
+			settingsChangedSinceUpdate = true;
+		}
+		key->release();
+		return;
+	}
+	OSDictionary *adapter = OSDictionary::withCapacity(5);
+	unsigned w = (inputMa * 5 + 500) / 1000;
+	OSNumber *watts = OSNumber::withNumber(w ? w : 1, 32);
+	OSNumber *current = OSNumber::withNumber(inputMa, 32);
+	OSNumber *voltage = OSNumber::withNumber(5000ULL, 32);
+	OSNumber *family = OSNumber::withNumber(0xe000400aULL, 32);
+	if (adapter && watts && current && voltage && family) {
+		adapter->setObject("Watts", watts);
+		adapter->setObject("Current", current);
+		adapter->setObject("Voltage", voltage);
+		adapter->setObject("FamilyCode", family);
+		adapter->setObject("IsWireless", kOSBooleanFalse);
+		setPSProperty(key, adapter);    /* equal contents: no change notification */
+	}
+	OSSafeReleaseNULL(family);
+	OSSafeReleaseNULL(voltage);
+	OSSafeReleaseNULL(current);
+	OSSafeReleaseNULL(watts);
+	OSSafeReleaseNULL(adapter);
+	key->release();
 }
 
