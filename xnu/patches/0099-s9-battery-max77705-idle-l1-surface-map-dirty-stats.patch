+	publish(percent, mv, ma, external, external && enabled, charging, full, true, true, false);
+	/* Real gauge numbers on top of the generic ones publish() writes. */
+	if (r.fullcaprep > 0) {
+		setMaxCapacity(r.fullcaprep);
+		setCurrentCapacity((r.fullcaprep * percent + 50) / 100);
+		putNumber("AppleRawMaxCapacity", r.fullcaprep);
+	}
+	putNumber("AppleRawCurrentCapacity", r.repcap);
+	if (r.designcap > 0) {
