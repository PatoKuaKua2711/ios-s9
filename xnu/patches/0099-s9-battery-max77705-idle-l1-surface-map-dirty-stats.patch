+	updateStatus();
+
+	snprintf(sweet_battery_state, sizeof(sweet_battery_state),
+	    "soc=%u.%u%% vcell=%umV avg=%dmA now=%dmA rep=%u/%umAh design=%umAh cycles=%u.%02u "
+	    "chgin=%d dtls=0x%x bat=%u cnfg00=0x%02x cnfg09=0x%02x(in %umA en %d) cc=%umA charge_mode=%d",
+	    soc10 / 10, soc10 % 10, mv, ma, ima, r.repcap, r.fullcaprep, r.designcap, r.cycles / 100,
+	    r.cycles % 100, external, dtls, (r.dtls1 >> 4) & 7, r.cnfg00, r.cnfg09, input,
+	    (r.cnfg09 & S9_CNFG09_CHG_EN) != 0, (r.cnfg02 & 0x3f) <= 2 ? 100 : (r.cnfg02 & 0x3f) * 50,
+	    sweet_charge_mode);
+	if (r.dtls1 != fLastDtls1 || r.int_ok != fLastIntOk || r.cnfg00 != fLastCnfg00) {
+		IOLog("SWEET BATTERY: %s\n", sweet_battery_state);
+		fLastDtls1 = r.dtls1;
+		fLastIntOk = r.int_ok;
+		fLastCnfg00 = r.cnfg00;
+	}
+	return true;
+}
