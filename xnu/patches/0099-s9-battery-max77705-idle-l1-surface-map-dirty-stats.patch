+/*
+ * The charge switch, from the polling thread (it owns the bus): a request
+ * from the sysctl, or the automatic turn-off of charging we turned on.
+ */
+void
+SweetBattery::s9Charge(const struct s9_battery_regs *r)
+{
+	unsigned mv = (unsigned)(((uint64_t)r->vcell * 78125) / 1000000);
+	unsigned cv = (r->cnfg04 & 0x3f) <= 4 ? 4000 + 50 * (r->cnfg04 & 0x3f) : 4200 + 10 * ((r->cnfg04 & 0x3f) - 4);
+	int request = sweet_charge_request;
+	sweet_charge_request = -1;
+
+	if (sweet_charge_mode == 1 && mv >= 4360) {
+		request = 2;
+		IOLog("SWEET BATTERY: cell at %u mV, turning the charging we enabled off\n", mv);
+	}
+	if (request == 1) {
+		if ((r->status & (1u << 3)) || !(r->int_ok & S9_CHGIN_OK) || mv >= 4300 ||
+		    (r->cnfg04 & 0x3f) > S9_CV_4350MV || !(r->cnfg00 & S9_CNFG00_BUCK)) {
+			IOLog("SWEET BATTERY: charging NOT enabled (battery %s, CHGIN %s, %u mV, float %u mV, CNFG_00 0x%02x)\n",
+			    (r->status & (1u << 3)) ? "absent" : "ok", (r->int_ok & S9_CHGIN_OK) ? "ok" : "absent",
+			    mv, cv, r->cnfg00);
+			return;
+		}
+		/* Unlock the protected charger settings (CHGPROT = 11), as max77705_charger_unlock. */
+		uint8_t cnfg06 = 0;
+		(void)sweet_max77705_read(S9_CHG, S9_CHG_CNFG_06, &cnfg06, 1);
+		const uint8_t unlock[2] = { S9_CHG_CNFG_06, (uint8_t)(cnfg06 | (3u << 2)) };
+		const uint8_t en09[2] = { S9_CHG_CNFG_09, (uint8_t)(r->cnfg09 | S9_CNFG09_CHG_EN) };
+		const uint8_t on00[2] = { S9_CHG_CNFG_00, (uint8_t)(r->cnfg00 | S9_CNFG00_CHG) };
+		int err = sweet_max77705_write(S9_CHG, unlock, 2);
+		if (!err) {
+			err = sweet_max77705_write(S9_CHG, en09, 2);
+		}
+		if (!err) {
+			err = sweet_max77705_write(S9_CHG, on00, 2);
+		}
+		sweet_charge_mode = err ? sweet_charge_mode : 1;
+		IOLog("SWEET BATTERY: charging on (%d): CNFG_00 0x%02x -> 0x%02x, CNFG_09 0x%02x -> 0x%02x, float %u mV\n",
+		    err, r->cnfg00, on00[1], r->cnfg09, en09[1], cv);
+	} else if (request == 2) {
+		const uint8_t off00[2] = { S9_CHG_CNFG_00, (uint8_t)(r->cnfg00 & ~S9_CNFG00_CHG) };
+		int err = sweet_max77705_write(S9_CHG, off00, 2);
+		sweet_charge_mode = err ? sweet_charge_mode : 2;
+		IOLog("SWEET BATTERY: charging off (%d): CNFG_00 0x%02x -> 0x%02x\n", err, r->cnfg00, off00[1]);
+	}
+}
