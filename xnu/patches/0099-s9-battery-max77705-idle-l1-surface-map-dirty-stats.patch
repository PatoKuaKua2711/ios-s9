+/* One 16-bit fuel gauge register, low byte first. */
+bool
+SweetBattery::s9Word(uint8_t reg, uint16_t *out)
+{
+	uint8_t b[2];
+	if (sweet_max77705_read(S9_FG, reg, b, 2) != 0) {
+		return false;
+	}
+	*out = (uint16_t)(b[0] | (b[1] << 8));
+	return true;
+}
+
+bool
+SweetBattery::s9Read(struct s9_battery_regs *r)
+{
+	uint16_t cur, avg;
+	bool ok = s9Word(S9_FG_STATUS, &r->status) && s9Word(S9_FG_REPSOC, &r->repsoc) &&
+	    s9Word(S9_FG_VCELL, &r->vcell) && s9Word(S9_FG_CURRENT, &cur) &&
+	    s9Word(S9_FG_AVGCURRENT, &avg) && s9Word(S9_FG_REPCAP, &r->repcap) &&
+	    s9Word(S9_FG_FULLCAPREP, &r->fullcaprep) && s9Word(S9_FG_CYCLES, &r->cycles) &&
+	    s9Word(S9_FG_DESIGNCAP, &r->designcap) && s9Word(S9_FG_TTE, &r->tte) &&
+	    s9Word(S9_FG_TTF, &r->ttf);
+	r->current = (int16_t)cur;
+	r->avgcurrent = (int16_t)avg;
+	ok = ok && sweet_max77705_read(S9_CHG, S9_CHG_INT_OK, &r->int_ok, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_DETAILS_00, &r->dtls0, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_DETAILS_01, &r->dtls1, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_DETAILS_02, &r->dtls2, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_CNFG_00, &r->cnfg00, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_CNFG_02, &r->cnfg02, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_CNFG_04, &r->cnfg04, 1) == 0 &&
+	    sweet_max77705_read(S9_CHG, S9_CHG_CNFG_09, &r->cnfg09, 1) == 0;
+	return ok;
+}
