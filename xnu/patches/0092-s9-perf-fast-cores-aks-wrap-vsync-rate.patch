+/* Tag in front of a "wrapped" key (wrap = tag + key, as AES key wrap adds 8 bytes). */
+static const uint8_t sweet_aks_wrap_tag[8] = { 'S', '9', 'A', 'K', 'S', 'W', '0', '1' };
+#define SWEET_AKS_MAX_KEY       128
