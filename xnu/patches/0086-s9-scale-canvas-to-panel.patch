+/*
+ * Galaxy S9: one layer, canvas rectangle (dx,dy,w,h) from surface (sx,sy), to
+ * the panel through the fit-height scale. Same clipping and bounds rules as
+ * the unscaled copy in present().
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (src == 0 || bpe != 4 || w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->memory == NULL) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	/* Panel rows/columns whose canvas pixel lies inside the rectangle. */
+	int32_t py0 = (int32_t)(((int64_t)dy * fPanH + fLogicalH - 1) / fLogicalH);
+	int32_t py1 = (int32_t)(((int64_t)(dy + h) * fPanH + fLogicalH - 1) / fLogicalH);
+	int32_t px0 = (int32_t)(((int64_t)dx * fPanW + fLogicalW - 1) / fLogicalW);
+	int32_t px1 = (int32_t)(((int64_t)(dx + w) * fPanW + fLogicalW - 1) / fLogicalW);
+	if (py1 > fPanH) {
+		py1 = fPanH;
+	}
+	if (px1 > fPanW) {
+		px1 = fPanW;
+	}
+	const uintptr_t base = src + s->offset;
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)((int64_t)py * fLogicalH / fPanH);
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + ly - dy) * s->bytesPerRow) + sx - dx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)(fPanY + py) * fRowBytes) + fPanX;
+		for (int32_t px = px0; px < px1; px++) {
+			drow[px] = srow[fXTab[px]];
+		}
+	}
+}
