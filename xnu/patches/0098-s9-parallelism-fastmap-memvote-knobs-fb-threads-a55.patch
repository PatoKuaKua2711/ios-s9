+/*
+ * sysctl kern.sweet_parallelism: libdispatch sizes dispatch_apply by the
+ * parallelism the kernel reports for the caller's QoS. CoreAnimation's CPU
+ * renderer splits every polygon into 4-row chunks with dispatch_apply and waits
+ * for the last one, so with all eight cores an A55 (~3x slower) may hold up
+ * each polygon. N > 0 reports N for QoS default and above (4 = the A75s).
+ */
+int sweet_parallelism;
 
