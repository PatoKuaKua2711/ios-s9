+/*
+ * sysctl kern.sweet_gesture="X0 Y0 X1 Y1 MS": one synthetic stroke in panel
+ * pixels (1440x2960) over MS milliseconds, or a tap at X0,Y0 if MS is 0. E.g.
+ * "720 2950 720 1500 150" swipes up from the bottom edge (unlock, go home).
+ */
+static int gesture_args[5];
+
+static void
+gesture_thread(void *arg, wait_result_t result)
+{
+	const int finger = TOUCH_MAX - 2;
+	int x0 = gesture_args[0], y0 = gesture_args[1], x1 = gesture_args[2], y1 = gesture_args[3];
+	int steps = gesture_args[4] / 8;
+	(void)arg;
+	(void)result;
+	if (steps <= 0) {
+		sweet_hid_touch(finger, 1, x0, y0);
+		touch_wait(60);
+		sweet_hid_touch(finger, 0, x0, y0);
+	} else {
+		for (int i = 0; i <= steps; i++) {
+			sweet_hid_touch(finger, 1, x0 + (x1 - x0) * i / steps, y0 + (y1 - y0) * i / steps);
+			touch_wait(8);
+		}
+		sweet_hid_touch(finger, 0, x1, y1);
+	}
+	swipe_busy = 0;
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+sysctl_sweet_gesture SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[64];
+	int changed = 0, v[5] = {0, 0, 0, 0, 0}, n = 0;
+	thread_t thread;
+
+	buf[0] = 0;
+	int error = sysctl_io_string(req, buf, sizeof(buf), 0, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	for (const char *p = buf; *p != 0 && n < 5;) {
+		while (*p == ' ' || *p == ',') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		int x = 0;
+		while (*p >= '0' && *p <= '9' && x < 100000) {
+			x = x * 10 + (*p++ - '0');
+		}
+		v[n++] = x;
+	}
+	if (n != 5 || v[0] >= SECTS_PANEL_W || v[2] >= SECTS_PANEL_W || v[1] >= SECTS_PANEL_H ||
+	    v[3] >= SECTS_PANEL_H || v[4] > 5000) {
+		return EINVAL;
+	}
+	if (!OSCompareAndSwap(0, 1, &swipe_busy)) {
+		return EBUSY;
+	}
+	memcpy(gesture_args, v, sizeof(v));
+	if (kernel_thread_start(gesture_thread, NULL, &thread) != KERN_SUCCESS) {
+		swipe_busy = 0;
+		return ENOMEM;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gesture, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_gesture, "A", "S9: synthetic stroke \"x0 y0 x1 y1 ms\" in panel pixels (ms 0: tap)");
+
 void
 sweet_touch_init(void)
 {
