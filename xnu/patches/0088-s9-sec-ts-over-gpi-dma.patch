+/*
+ * Galaxy S9: SE11's firmware has the FIFO interface disabled
+ * (GENI_IF_DISABLE_RO bit 0; DT dmas = gpi_dma1 ch 0/1, seid 3, I2C), so
+ * transfers go through QUPv3 wrapper1's GPI DMA engine at 0xa00000, polled:
+ * GPII 1 (from gpii-mask 0xfa), TX channel 0, RX channel 1, one event ring.
+ * Register map, contexts, commands and TRE formats from drivers/dma/qcom/gpi.c,
+ * msm_gpi_mmio.h, include/linux/msm_gpi.h and the GSI path of i2c-qcom-geni.c.
+ */
+#define GPI_PA           0x00a00000u
+#define GPI_LEN          0x00060000u
+#define GPII             1u
+#define GPII_OFF(o)      ((uint32_t)(o) + 0x4000u * GPII)
+#define GPI_CH_CX(k)     GPII_OFF(0x20000u + 0x80u * (k))
+#define GPI_EV_CX        GPII_OFF(0x21000u)
+#define GPI_CH_DB(k)     GPII_OFF(0x22000u + 0x8u * (k))
+#define GPI_EV_DB        GPII_OFF(0x22100u)
+#define GPI_CH_CMD       GPII_OFF(0x23008u)
+#define GPI_EV_CMD       GPII_OFF(0x23010u)
+#define GPI_CH_QOS(k)    GPII_OFF(0x2005cu + 0x80u * (k))
+#define GPI_CH_SCR(k, i) GPII_OFF(0x20060u + 0x80u * (k) + 4u * (i))
+#define GPI_TYPE_IRQ     GPII_OFF(0x23080u)
+#define GPI_GLOB_IRQ     GPII_OFF(0x23100u)
+#define GPI_GPII_IRQ     GPII_OFF(0x23118u)
+#define GPI_ERROR_LOG    GPII_OFF(0x23200u)
+#define CX_CONFIG        0x00u
+#define CX_LEN           0x04u
+#define CX_BASE_LO       0x08u
+#define CX_BASE_HI       0x0cu
+#define CX_RP_LO         0x10u
+#define CX_WP_LO         0x18u
+#define CX_INT_MOD       0x20u
+#define CX_MSI_LO        0x28u
+#define CX_MSI_HI        0x2cu
+#define CX_RPU_LO        0x30u
+#define CX_RPU_HI        0x34u
+#define GPI_OP_ALLOC     0u
+#define GPI_OP_START     1u
+#define GPI_OP_STOP      2u
+#define GPI_OP_RESET     9u
+#define GPI_OP_DEALLOC   10u
+#define GPI_N            16u     /* elements per ring, 16 bytes each */
+#define GPI_RING_LEN     (GPI_N * 16u)
+#define GD_TX            0x000u  /* rings aligned to their length */
+#define GD_RX            0x100u
+#define GD_EV            0x200u
+#define GD_TXBUF         0x400u
+#define GD_RXBUF         0x480u
+#define GPI_EV_XFER      0x22u
+#define GPI_EV_QUP       0x31u
+#define GPI_NONE         0xffffffffu
+
+static struct {
+	vm_offset_t regs, dma;
+	uint64_t pa;
+	unsigned tx, rx, ev, evw;       /* next TX/RX slot, next event, event doorbell slot */
+	bool on, held;                  /* GPI mode; last message kept the bus (stretch) */
+} gsi;
+
+static uint32_t
+gsi_lo(uint32_t off)
+{
+	return (uint32_t)(gsi.pa + off);
+}
+
+static uint32_t
+gsi_hi(uint32_t off)
+{
+	return (uint32_t)((gsi.pa + off) >> 32);
+}
+
+static unsigned
+gsi_state(uint32_t cx)
+{
+	return (touch_rd(gsi.regs, cx + CX_CONFIG) >> 20) & 0xfu;
+}
+
+/* Channel / event ring command; the context's state field says when it is done. */
+static bool
+gsi_cmd(uint32_t reg, unsigned op, unsigned chid, uint32_t cx, unsigned want)
+{
+	touch_wr(gsi.regs, reg, (op << 24) | chid);
+	for (unsigned i = 0; i < 100000; ++i) {
+		if (gsi_state(cx) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET TOUCH: GPI cmd %u ch %u: state %u, want %u\n", op, chid, gsi_state(cx), want);
+	return false;
+}
+
+static void
+gsi_tre(uint32_t ring, unsigned idx, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(gsi.dma + ring + 16u * idx);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+}
+
+/* Channel context as gpi_alloc_chan programs it, after ALLOCATE and after a reset. */
+static void
+gsi_chan_cx(unsigned k)
+{
+	uint32_t ring = k ? GD_RX : GD_TX;
+	/* TX = channel 0 (OUT, pair 1), RX = channel 1 (IN, pair 0); GPI protocol, event ring 0 */
+	touch_wr(gsi.regs, GPI_CH_CX(k) + CX_CONFIG, (16u << 24) | ((k ? 0u : 1u) << 3) | 2u);
+	touch_wr(gsi.regs, GPI_CH_CX(k) + CX_LEN, GPI_RING_LEN);
+	touch_wr(gsi.regs, GPI_CH_CX(k) + CX_BASE_LO, gsi_lo(ring));
+	touch_wr(gsi.regs, GPI_CH_CX(k) + CX_BASE_HI, gsi_hi(ring));
+	touch_wr(gsi.regs, GPI_CH_DB(k) + 4u, gsi_hi(ring));
+	/* SCRATCH_0: pair, protocol 3 (I2C), SE 3 of wrapper1 = SE11 */
+	touch_wr(gsi.regs, GPI_CH_SCR(k, 0), ((k ? 0u : 1u) << 16) | (3u << 4) | 3u);
+	touch_wr(gsi.regs, GPI_CH_SCR(k, 1), 0);
+	touch_wr(gsi.regs, GPI_CH_SCR(k, 2), 0);
+	touch_wr(gsi.regs, GPI_CH_SCR(k, 3), 0);
+	touch_wr(gsi.regs, GPI_CH_QOS(k), 1);
+}
+
+/* Next event the hardware wrote, if any; its slot goes straight back to the ring. */
+static bool
+gsi_ev_pop(uint32_t *w)
+{
+	unsigned hw = ((touch_rd(gsi.regs, GPI_EV_CX + CX_RP_LO) - gsi_lo(GD_EV)) / 16u) % GPI_N;
+	if (gsi.ev == hw) {
+		return false;
+	}
+	uint32_t off = GD_EV + 16u * gsi.ev;
+	flush_dcache64((addr64_t)(gsi.pa + off), 16, TRUE);
+	for (unsigned i = 0; i < 4; ++i) {
+		w[i] = ((volatile uint32_t *)(gsi.dma + off))[i];
+	}
+	gsi.ev = (gsi.ev + 1u) % GPI_N;
+	gsi.evw = (gsi.evw + 1u) % GPI_N;
+	touch_wr(gsi.regs, GPI_EV_DB, gsi_lo(GD_EV + 16u * gsi.evw));
+	return true;
+}
+
+static void
+gsi_dump(const char *why)
+{
+	printf("SWEET TOUCH: GPI %s: ch0=%u rp=%#x wp=%#x ch1=%u rp=%#x wp=%#x ev=%u rp=%#x "
+	    "type=%#x glob=%#x gpii=%#x err=%#x se=%#x m=%#x ios=%#x\n", why,
+	    gsi_state(GPI_CH_CX(0)), touch_rd(gsi.regs, GPI_CH_CX(0) + CX_RP_LO),
+	    touch_rd(gsi.regs, GPI_CH_CX(0) + CX_WP_LO),
+	    gsi_state(GPI_CH_CX(1)), touch_rd(gsi.regs, GPI_CH_CX(1) + CX_RP_LO),
+	    touch_rd(gsi.regs, GPI_CH_CX(1) + CX_WP_LO),
+	    gsi_state(GPI_EV_CX), touch_rd(gsi.regs, GPI_EV_CX + CX_RP_LO),
+	    touch_rd(gsi.regs, GPI_TYPE_IRQ), touch_rd(gsi.regs, GPI_GLOB_IRQ),
+	    touch_rd(gsi.regs, GPI_GPII_IRQ), touch_rd(gsi.regs, GPI_ERROR_LOG),
+	    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ), touch_rd(st.se, 0x908));
+}
+
+/* Like gpi_terminate_all: stop, reset, reprogram and restart both channels. */
+static bool
+gsi_reset(void)
+{
+	uint32_t w[4];
+	for (unsigned k = 0; k < 2; ++k) {
+		if (gsi_state(GPI_CH_CX(k)) != 1u && gsi_state(GPI_CH_CX(k)) != 3u) {
+			(void)gsi_cmd(GPI_CH_CMD, GPI_OP_STOP, k, GPI_CH_CX(k), 3);
+		}
+	}
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!gsi_cmd(GPI_CH_CMD, GPI_OP_RESET, k, GPI_CH_CX(k), 1)) {
+			return false;
+		}
+		gsi_chan_cx(k);
+	}
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!gsi_cmd(GPI_CH_CMD, GPI_OP_START, k, GPI_CH_CX(k), 2)) {
+			return false;
+		}
+	}
+	while (gsi_ev_pop(w)) {
+		/* completions of the TREs the reset dropped */
+	}
+	gsi.tx = gsi.rx = 0;
+	gsi.held = false;
+	return true;
+}
+
+static bool
+gsi_init(void)
+{
+	gsi.regs = ml_io_map(GPI_PA, GPI_LEN);
+	if (!gsi.regs || kmem_alloc_contig(kernel_map, &gsi.dma, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET TOUCH: GPI mapping or DMA memory failed\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)gsi.dma);
+	if (!pn) {
+		return false;
+	}
+	gsi.pa = ptoa_64(pn);
+	/* No dirty zero lines may be written back over what the engine stores. */
+	flush_dcache64((addr64_t)gsi.pa, PAGE_SIZE, TRUE);
+	printf("SWEET TOUCH: SE11 FIFO off -> GPI gpii%u ch0=%u ch1=%u ev=%u dma=%#llx\n",
+	    GPII, gsi_state(GPI_CH_CX(0)), gsi_state(GPI_CH_CX(1)), gsi_state(GPI_EV_CX),
+	    (unsigned long long)gsi.pa);
+	/* geni_se_select_gsi_mode: the SE reports to GPI, no local interrupts. */
+	touch_wr(st.se, 0xe1c, 0);
+	touch_wr(st.se, 0x644, touch_rd(st.se, 0x644) & ~1u);
+	touch_wr(st.se, SE_IRQ_EN, touch_rd(st.se, SE_IRQ_EN) &
+	    ~(SE_DONE | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, 0xc44, 0xffffffffu);
+	touch_wr(st.se, 0xd44, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, touch_rd(st.se, SE_DMA) | 1u);
+	touch_wr(st.se, 0xe18, touch_rd(st.se, 0xe18) | 0xfu);
+	/* Leftovers from firmware: stop, reset and free before taking the GPII. */
+	for (unsigned k = 0; k < 2; ++k) {
+		if (gsi_state(GPI_CH_CX(k)) == 2u) {
+			(void)gsi_cmd(GPI_CH_CMD, GPI_OP_STOP, k, GPI_CH_CX(k), 3);
+		}
+		if (gsi_state(GPI_CH_CX(k)) != 0u) {
+			(void)gsi_cmd(GPI_CH_CMD, GPI_OP_RESET, k, GPI_CH_CX(k), 1);
+			(void)gsi_cmd(GPI_CH_CMD, GPI_OP_DEALLOC, k, GPI_CH_CX(k), 0);
+		}
+	}
+	if (gsi_state(GPI_EV_CX) != 0u) {
+		(void)gsi_cmd(GPI_EV_CMD, GPI_OP_RESET, 0, GPI_EV_CX, 1);
+		(void)gsi_cmd(GPI_EV_CMD, GPI_OP_DEALLOC, 0, GPI_EV_CX, 0);
+	}
+	/* gpi_config_interrupts with every source masked (polled); wired IRQ, not MSI. */
+	touch_wr(gsi.regs, GPII_OFF(0x23088u), 0);      /* TYPE_IRQ_MSK */
+	touch_wr(gsi.regs, GPII_OFF(0x230b8u), 0);      /* SRC_IEOB_IRQ_MSK */
+	touch_wr(gsi.regs, GPII_OFF(0x23098u), 0);      /* SRC_CH_IRQ_MSK */
+	touch_wr(gsi.regs, GPII_OFF(0x2309cu), 0);      /* SRC_EV_CH_IRQ_MSK */
+	touch_wr(gsi.regs, GPII_OFF(0x23108u), 0);      /* GLOB_IRQ_EN */
+	touch_wr(gsi.regs, GPII_OFF(0x23120u), 0);      /* GPII_IRQ_EN */
+	touch_wr(gsi.regs, GPII_OFF(0x23188u), 0);      /* MSI_BASE_LSB */
+	touch_wr(gsi.regs, GPII_OFF(0x2318cu), 0);      /* MSI_BASE_MSB */
+	touch_wr(gsi.regs, GPII_OFF(0x23400u), 0);      /* SCRATCH_0 */
+	touch_wr(gsi.regs, GPII_OFF(0x23404u), 0);      /* SCRATCH_1 */
+	touch_wr(gsi.regs, GPII_OFF(0x23180u), 1);      /* INTSET */
+	touch_wr(gsi.regs, GPI_ERROR_LOG, 0);
+	/* Event ring 0 (gpi_alloc_ev_chan): 16-byte elements, IRQ type, GPI event channel. */
+	touch_wr(gsi.regs, GPI_EV_CX + CX_CONFIG, (16u << 24) | (1u << 16) | 2u);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_LEN, GPI_RING_LEN);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_BASE_LO, gsi_lo(GD_EV));
+	touch_wr(gsi.regs, GPI_EV_CX + CX_BASE_HI, gsi_hi(GD_EV));
+	touch_wr(gsi.regs, GPI_EV_DB + 4u, gsi_hi(GD_EV));
+	touch_wr(gsi.regs, GPI_EV_CX + CX_INT_MOD, 0);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_MSI_LO, 0);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_MSI_HI, 0);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_RPU_LO, 0);
+	touch_wr(gsi.regs, GPI_EV_CX + CX_RPU_HI, 0);
+	if (!gsi_cmd(GPI_EV_CMD, GPI_OP_ALLOC, 0, GPI_EV_CX, 1)) {
+		gsi_dump("event ring alloc");
+		return false;
+	}
+	/* Hand the hardware all but one event element. */
+	gsi.ev = 0;
+	gsi.evw = GPI_N - 1u;
+	touch_wr(gsi.regs, GPI_EV_DB, gsi_lo(GD_EV + 16u * gsi.evw));
+	/* Channels (gpi_alloc_chan): ALLOCATE first, then the context; then START both. */
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!gsi_cmd(GPI_CH_CMD, GPI_OP_ALLOC, k, GPI_CH_CX(k), 1)) {
+			gsi_dump("channel alloc");
+			return false;
+		}
+		gsi_chan_cx(k);
+	}
+	for (unsigned k = 0; k < 2; ++k) {
+		if (!gsi_cmd(GPI_CH_CMD, GPI_OP_START, k, GPI_CH_CX(k), 2)) {
+			gsi_dump("channel start");
+			return false;
+		}
+	}
+	gsi.tx = gsi.rx = 0;
+	gsi.on = true;
+	gsi_dump("ready");
+	return true;
+}
+
+/*
+ * Completion events for the TREs at ring offsets tx_tre / rx_tre (GPI_NONE:
+ * no wait): 0, ENXIO (NACK), EIO or ETIMEDOUT. An event names the TRE that
+ * raised it; others are completions a reset dropped, and are skipped.
+ */
+static int
+gsi_wait(uint32_t tx_tre, uint32_t rx_tre)
+{
+	bool tx_done = tx_tre == GPI_NONE, rx_done = rx_tre == GPI_NONE;
+	uint32_t w[4];
+	int err = 0;
+	for (unsigned i = 0; i < 50000 && !err && !(tx_done && rx_done); ++i) {
+		if (!gsi_ev_pop(w)) {
+			delay(1);
+			continue;
+		}
+		unsigned type = (w[3] >> 16) & 0xffu, chid = w[3] >> 24, code = w[2] >> 24;
+		if (type == GPI_EV_XFER && chid == 0 && !tx_done && w[0] == gsi_lo(tx_tre)) {
+			tx_done = true;
+		} else if (type == GPI_EV_XFER && chid == 1 && !rx_done && w[0] == gsi_lo(rx_tre)) {
+			rx_done = true;
+		} else if (type == GPI_EV_QUP) {
+			/* SE M_IRQ status, as in gi2c_ev_cb: bit 10 = NACK */
+			err = (w[0] & (1u << 10)) ? ENXIO : EIO;
+		} else {
+			if (st.probing) {
+				printf("SWEET TOUCH: GPI stale event %08x %08x %08x %08x\n", w[0], w[1], w[2], w[3]);
+			}
+			continue;
+		}
+		if (type == GPI_EV_XFER && code != 1u && code != 2u && code != 4u) {
+			err = EIO;
+		}
+		if (st.probing || err) {
+			printf("SWEET TOUCH: GPI event %08x %08x %08x %08x\n", w[0], w[1], w[2], w[3]);
+		}
+	}
+	if (!err && !(tx_done && rx_done)) {
+		gsi_dump(tx_done ? "rx timeout" : "tx timeout");
+		err = ETIMEDOUT;
+	}
+	return err;
+}
+
+/* One message, like geni_i2c_gsi_xfer: CONFIG0 (unless the bus is held), GO, data. */
+static int
+gsi_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	uint32_t go = ((stretch ? 1u << 2 : 0u) << 24) | ((uint32_t)addr << 8);
+	uint32_t tx_tre, rx_tre = GPI_NONE;
+	if (st.dead || nr > 90 || nt > 3 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!gsi.held) {
+		/* 100 kHz from the 19.2 MHz SE clock: pack, t_cycle 26, t_high 10, t_low 11, div 7; chained */
+		gsi_tre(GD_TX, gsi.tx, (3u << 24) | (26u << 16) | (10u << 8) | 11u, 0, 7u,
+		    (2u << 20) | (2u << 16) | 1u);
+		gsi.tx = (gsi.tx + 1u) % GPI_N;
+	}
+	if (nr) {
+		/* The RX buffer TRE goes in before the GO, as the Linux driver issues them. */
+		flush_dcache64((addr64_t)(gsi.pa + GD_RXBUF), nr, TRUE);
+		rx_tre = GD_RX + 16u * gsi.rx;
+		gsi_tre(GD_RX, gsi.rx, gsi_lo(GD_RXBUF), gsi_hi(GD_RXBUF), nr, (1u << 20) | (1u << 9));
+		gsi.rx = (gsi.rx + 1u) % GPI_N;
+		clean_dcache64((addr64_t)(gsi.pa + GD_RX), GPI_RING_LEN, TRUE);
+		touch_wr(gsi.regs, GPI_CH_DB(1), gsi_lo(GD_RX + 16u * gsi.rx));
+		tx_tre = GD_TX + 16u * gsi.tx;
+		gsi_tre(GD_TX, gsi.tx, go | 2u, 0, nr, (2u << 20) | (1u << 8));    /* GO read, IEOB */
+	} else {
+		volatile uint8_t *b = (volatile uint8_t *)(gsi.dma + GD_TXBUF);
+		for (unsigned i = 0; i < nt; ++i) {
+			b[i] = tx[i];
+		}
+		clean_dcache64((addr64_t)(gsi.pa + GD_TXBUF), nt, TRUE);
+		gsi_tre(GD_TX, gsi.tx, go | 1u, 0, 0, (2u << 20) | 1u);             /* GO write, chained */
+		gsi.tx = (gsi.tx + 1u) % GPI_N;
+		tx_tre = GD_TX + 16u * gsi.tx;
+		gsi_tre(GD_TX, gsi.tx, gsi_lo(GD_TXBUF), gsi_hi(GD_TXBUF), nt, (1u << 20) | (1u << 9));
+	}
+	gsi.tx = (gsi.tx + 1u) % GPI_N;
+	clean_dcache64((addr64_t)(gsi.pa + GD_TX), GPI_RING_LEN, TRUE);
+	touch_wr(gsi.regs, GPI_CH_DB(0), gsi_lo(GD_TX + 16u * gsi.tx));
+	int err = gsi_wait(tx_tre, rx_tre);
+	if (err) {
+		/* dmaengine_terminate_all, then CONFIG0 again on the next message */
+		if (!gsi_reset()) {
+			gsi_dump("reset failed");
+			st.dead = true;
+		}
+		return err;
+	}
+	gsi.held = stretch;
+	if (nr) {
+		flush_dcache64((addr64_t)(gsi.pa + GD_RXBUF), nr, TRUE);
+		for (unsigned i = 0; i < nr; ++i) {
+			rx[i] = ((volatile uint8_t *)(gsi.dma + GD_RXBUF))[i];
+		}
+		st.got = nr;
+	} else {
+		st.sent = nt;
+	}
+	return 0;
+}
+
 static int
 touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
     unsigned nr, bool stretch)
 {
 	st.irq_status = st.irq_last = 0;
 	st.sent = st.got = 0;
-	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+	int err = gsi.on ? gsi_msg(addr, tx, nt, rx, nr, stretch) :
+	    touch_msg_run(addr, tx, nt, rx, nr, stretch);
 	if (st.probing) {
 		printf("SWEET TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
 		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
