+/*
+ * Galaxy S9: CPU and L3 clocks. ABL leaves gold at its lowest row (825 MHz)
+ * and nothing in XNU does DCVS, so pick fixed rows the way Linux's
+ * clk-cpu-osm does (SDM845 OSM v2): XBL already loaded the frequency table
+ * (FREQ_REG, 40 rows), the OSM handles voltage itself, the kernel only writes
+ * a row index to DCVS_PERF_STATE_DESIRED. Silver and L3 stay at or below
+ * qcom,mx-turbo-freq (1689.6 / 1478.4 MHz): above it Linux votes the MX rail
+ * to turbo over RPMh, which we do not do. Tested in shim M6: gold 825 -> 2706
+ * MHz measured. Boot-args: sweetcpu=0 leaves ABL's clocks, sweetcpu_mhz=N
+ * caps gold (default 2649, the top row for all four cores).
+ */
+#define SWEET_OSM_ROWS          40
+#define SWEET_OSM_FREQ(i)       (0x110 + 32 * (i))
+#define SWEET_OSM_DCVS_CTRL     0xbc
+#define SWEET_OSM_PSTATE        0x700
+#define SWEET_OSM_DESIRED(c)    (0x920 + 4 * (c))
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static void
+sweet_osm_set(const char *name, uint64_t phys, uint32_t max_mhz, bool per_core_ok)
+{
+	volatile uint32_t *osm = (volatile uint32_t *)ml_io_map(phys, 0x1000);
+	uint32_t prev_khz = 0, prev_cc = 0, best_khz = 0;
+	int best = -1;
+
+	for (int i = 0; i < SWEET_OSM_ROWS; i++) {
+		uint32_t v = osm[SWEET_OSM_FREQ(i) / 4];
+		uint32_t khz = (v >> 30) ? 19200 * (v & 0xff) : 300000;
+		uint32_t cc = (v >> 16) & 7;
+		if (i > 0 && khz == prev_khz && cc == prev_cc) {
+			break;          /* the table repeats its last row */
+		}
+		prev_khz = khz;
+		prev_cc = cc;
+		if (cc == 4 && khz / 1000 <= max_mhz && khz >= best_khz) {
+			best = i;
+			best_khz = khz;
+		}
+	}
+	if (best < 0) {
+		IOLog("SWEET CPU: %s OSM: no row <= %u MHz, left as is\n", name, max_mhz);
+		return;
+	}
+	uint32_t was = osm[SWEET_OSM_DESIRED(0) / 4];
+	bool per_core = per_core_ok && (osm[SWEET_OSM_DCVS_CTRL / 4] & 1);
+	for (int c = 0; c < (per_core ? 4 : 1); c++) {
+		osm[SWEET_OSM_DESIRED(c) / 4] = (uint32_t)best;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	IOLog("SWEET CPU: %s OSM row %u -> %d (%u MHz)\n", name, was, best, best_khz / 1000);
+}
+
+static void
+sweet_cpu_clocks(void)
+{
+	uint32_t on = 1, gold_mhz = 2649;
+	PE_parse_boot_argn("sweetcpu", &on, sizeof(on));
+	PE_parse_boot_argn("sweetcpu_mhz", &gold_mhz, sizeof(gold_mhz));
+	if (!on) {
+		IOLog("SWEET CPU: clocks left as ABL set them (sweetcpu=0)\n");
+		return;
+	}
+	sweet_osm_set("L3", 0x17d41000ULL, 1478, false);
+	sweet_osm_set("silver", 0x17d43000ULL, 1689, true);
+	sweet_osm_set("gold", 0x17d45800ULL, gold_mhz, true);
+}
+
