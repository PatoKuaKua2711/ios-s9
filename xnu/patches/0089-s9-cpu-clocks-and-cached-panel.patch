+void
+AppleCLCD::markRows(int64_t y0, int64_t y1)
+{
+	if (y0 < 0) {
+		y0 = 0;
+	}
+	if (y1 > (int64_t)fHeight) {
+		y1 = fHeight;
+	}
+	if (y0 >= y1) {
+		return;
+	}
+	if ((uint32_t)y0 < fCleanY0) {
+		fCleanY0 = (uint32_t)y0;
+	}
+	if ((uint32_t)y1 > fCleanY1) {
+		fCleanY1 = (uint32_t)y1;
+	}
+}
+
+/* Push the written rows out of the CPU caches to RAM, where the MDSS reads them. */
+void
+AppleCLCD::cleanRows(void)
+{
+	if (fCached && fCleanY0 < fCleanY1) {
+		uintptr_t a = (fPixels + (uint64_t)fCleanY0 * fRowBytes) & ~(uintptr_t)63;
+		uintptr_t end = fPixels + (uint64_t)fCleanY1 * fRowBytes;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (; a < end; a += 64) {
+			__asm__ volatile ("dc cvac, %0" : : "r"(a) : "memory");
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	fCleanY0 = fHeight;
+	fCleanY1 = 0;
+}
