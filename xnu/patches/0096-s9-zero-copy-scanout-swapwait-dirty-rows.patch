+/*
+ * Galaxy S9 benchmark: sysctl kern.sweet_swipe=N plays N flings up then down
+ * the middle of the panel with a synthetic finger (the last HID slot), the way
+ * a person scrolls a list, so frame rates can be measured with nobody at the
+ * phone. Each fling: 200 ms of moves every 8 ms, then 1.5 s for the scroll.
+ */
+static volatile UInt32 swipe_busy;
+
+static void
+swipe_fling(int y0, int y1)
+{
+	const int finger = TOUCH_MAX - 1, steps = 25;
+	for (int i = 0; i <= steps; i++) {
+		sweet_hid_touch(finger, 1, SECTS_PANEL_W / 2, y0 + (y1 - y0) * i / steps);
+		touch_wait(8);
+	}
+	sweet_hid_touch(finger, 0, SECTS_PANEL_W / 2, y1);
+}
+
+static void
+swipe_thread(void *arg, wait_result_t result)
+{
+	int n = (int)(uintptr_t)arg;
+	(void)result;
+	printf("SWEET TOUCH: %d synthetic flings\n", n);
+	for (int i = 0; i < n; i++) {
+		swipe_fling(2100, 900);
+		touch_wait(1500);
+		swipe_fling(900, 2100);
+		touch_wait(1500);
+	}
+	swipe_busy = 0;
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+sysctl_sweet_swipe SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int n = 0, changed = 0;
+	int error = sysctl_io_number(req, 0, sizeof(n), &n, &changed);
+	thread_t thread;
+
+	if (error || !changed) {
+		return error;
+	}
+	if (n < 1 || n > 100) {
+		return EINVAL;
+	}
+	if (!OSCompareAndSwap(0, 1, &swipe_busy)) {
+		return EBUSY;
+	}
+	if (kernel_thread_start(swipe_thread, (void *)(uintptr_t)n, &thread) != KERN_SUCCESS) {
+		swipe_busy = 0;
+		return ENOMEM;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_swipe, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_swipe, "I", "S9: N synthetic flings up and down the screen (benchmark)");
+
