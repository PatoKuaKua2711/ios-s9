+/*
+ * Galaxy S9 zero-copy. Read ABL's splash layout (shim M9 step 0) and check it
+ * is the one the rest of this code assumes; false leaves the CPU copy alone.
+ */
+bool
+AppleCLCD::zeroCopyInit(void)
+{
+	uint32_t half = fWidth / 2;
+	bool ok = fPhys == S9_SPLASH_PA && fWidth == 1440 && fHeight == 2960 && (fLogicalW & 1) == 0;
+
+	if (ok) {
+		fMdss = ml_io_map(S9_MDSS_PA, S9_MDSS_LEN);
+		ok = fMdss != 0;
+	}
+	if (!ok) {
+		IOLog("SWEET FB: zero-copy unavailable (splash 0x%llx %ux%u)\n", fPhys, fWidth, fHeight);
+		return false;
+	}
+	for (uint32_t p = 0; p < 2; p++) {
+		vm_offset_t b = fMdss + S9_VIG(p);
+		for (uint32_t r = 0; r < SWEET_ZC_NREGS; r++) {
+			fZCSaved[p][r] = s9_rd(b + sweet_zc_regs[r]);
+		}
+		ok = ok && s9_rd(b + SSPP_SRC0_ADDR) == (uint32_t)fPhys &&
+		    s9_rd(b + SSPP_SRC_SIZE) == ((fHeight << 16) | half) &&
+		    s9_rd(b + SSPP_SRC_XY) == (p ? half : 0) &&
+		    (s9_rd(b + SSPP_YSTRIDE0) & 0xffff) == fRowBytes &&
+		    s9_rd(b + QS + QS_VERSION) == 0x1003;
+	}
+	uint32_t out = s9_rd(fMdss + S9_VIG(0) + SSPP_OUT_SIZE);
+	fZCOutW = out & 0xffff;
+	fZCOutH = out >> 16;
+	fZCHalf = fLogicalW / 2;
+	ok = ok && fZCOutW == half && fZCOutH == fHeight;
+	IOLog("SWEET FB: zero-copy %s: VIG0 src 0x%x xy 0x%x out 0x%x addr 0x%x op 0x%x, VIG1 src 0x%x xy 0x%x addr 0x%x, qseed 0x%x/0x%x, ctl0 flush 0x%x\n",
+	    ok ? "ready" : "NOT ready (layout differs)",
+	    s9_rd(fMdss + S9_VIG(0) + SSPP_SRC_SIZE), s9_rd(fMdss + S9_VIG(0) + SSPP_SRC_XY), out,
+	    s9_rd(fMdss + S9_VIG(0) + SSPP_SRC0_ADDR), s9_rd(fMdss + S9_VIG(0) + SSPP_OP_MODE),
+	    s9_rd(fMdss + S9_VIG(1) + SSPP_SRC_SIZE), s9_rd(fMdss + S9_VIG(1) + SSPP_SRC_XY),
+	    s9_rd(fMdss + S9_VIG(1) + SSPP_SRC0_ADDR), s9_rd(fMdss + S9_VIG(0) + QS + QS_VERSION),
+	    s9_rd(fMdss + S9_VIG(1) + QS + QS_VERSION), s9_rd(fMdss + S9_CTL0_FLUSH));
+	fZCReady = ok;
+	return ok;
+}
+
+/*
+ * Each pipe fetches its half of the canvas (VIG1 from SRC_XY x = half) and
+ * its QSEED3 scales it bilinearly to its 720x2960 half of the panel, as
+ * sde_plane.c's default scaler3 setup (shim M9 step B). Addresses come with
+ * each flip; one flush applies everything at the next frame start.
+ */
+void
+AppleCLCD::zeroCopyStart(void)
+{
+	uint32_t src = (fLogicalH << 16) | fZCHalf;
+	uint32_t stx = (uint32_t)(((uint64_t)fZCHalf << 21) / fZCOutW);
+	uint32_t sty = (uint32_t)(((uint64_t)fLogicalH << 21) / fZCOutH);
+
+	for (uint32_t p = 0; p < 2; p++) {
+		vm_offset_t b = fMdss + S9_VIG(p), q = b + QS;
+		s9_wr(b + SSPP_SRC_XY, p ? fZCHalf : 0);
+		s9_wr(b + SSPP_SRC_SIZE, src);
+		s9_wr(b + SSPP_DECIMATION, 0);
+		for (uint32_t c = 0; c < 3; c++) {
+			s9_wr(b + SSPP_PE(c), 0);
+			s9_wr(b + SSPP_PE(c) + 4, 0);
+			s9_wr(b + SSPP_PE(c) + 8, src);
+		}
+		s9_wr(q + QS_INIT_Y_H, 0);
+		s9_wr(q + QS_INIT_Y_V, 0);
+		s9_wr(q + QS_INIT_UV_H, 0);
+		s9_wr(q + QS_INIT_UV_V, 0);
+		s9_wr(q + QS_STEP_Y_H, stx);
+		s9_wr(q + QS_STEP_UV_H, stx);
+		s9_wr(q + QS_STEP_Y_V, sty);
+		s9_wr(q + QS_STEP_UV_V, sty);
+		s9_wr(q + QS_PRELOAD, 4U | (3U << 8) | (4U << 16) | (3U << 24));
+		s9_wr(q + QS_SRC_SIZE, src);
+		s9_wr(q + QS_SRC_SIZE_UV, src);
+		s9_wr(q + QS_DST_SIZE, (fZCOutH << 16) | fZCOutW);
+		/* enable, bilinear, 8-bit, alpha on + bilinear alpha (version 0x1003) */
+		s9_wr(q + QS_OP_MODE, 1U | (3U << 16) | (1U << 14) | (1U << 10) | (1U << 29));
+	}
+	fZCActive = true;
+	fPanelStale = true;
+	IOLog("SWEET FB: zero-copy on: canvas halves %ux%u -> %ux%u, step 0x%x/0x%x\n",
+	    fZCHalf, fLogicalH, fZCOutW, fZCOutH, stx, sty);
+}
+
+/* The pipes back on the panel memory as ABL left them (CPU copies). fShowLock held. */
+void
+AppleCLCD::zeroCopyStop(void)
+{
+	for (uint32_t p = 0; p < 2; p++) {
+		vm_offset_t b = fMdss + S9_VIG(p);
+		for (uint32_t r = 0; r < SWEET_ZC_NREGS; r++) {
+			s9_wr(b + sweet_zc_regs[r], fZCSaved[p][r]);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	s9_wr(fMdss + S9_CTL0_FLUSH, S9_FLUSH_BITS);
+	fZCActive = false;
+	IOLockLock(fLock);
+	fPendingFlipID = 0;
+	IOLockUnlock(fLock);
+	IOLog("SWEET FB: zero-copy off: pipes back on the panel memory\n");
+}
+
+/* The SDE took the last flush (it clears the bits at the frame start that applies them). */
+bool
+AppleCLCD::zeroCopyLatched(void)
+{
+	return fMdss == 0 || (s9_rd(fMdss + S9_CTL0_FLUSH) & S9_FLUSH_BITS) == 0;
+}
+
+/* The display slot surface a swap shows full screen in layer 0 alone (retained), or NULL. */
+SweetSurface *
+AppleCLCD::zeroCopySurface(const uint8_t *rec)
+{
+	const uint8_t *a = rec + 0x64, *b = rec + 0xc4;
+	if ((get32(rec, 0x104) & 0xf) != 1 || get32(a, 0) != 0 || get32(a, 4) != 0 ||
+	    get32(b, 0) != 0 || get32(b, 4) != 0 || get32(a, 8) != fLogicalW || get32(a, 12) != fLogicalH ||
+	    get32(b, 8) != fLogicalW || get32(b, 12) != fLogicalH) {
+		return NULL;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54));
+	if (s != NULL && (s->slot < 0 || s->width != fLogicalW || s->height != fLogicalH ||
+	    s->bytesPerRow > 0xffff || s->phys == 0 || s->phys + s->allocSize > S9_SPLASH_END)) {
+		OSSafeReleaseNULL(s);
+	}
+	return s;
+}
+
+/* Show slot surface s from the next frame on. fShowLock held. */
+void
+AppleCLCD::flip(SweetSurface *s, uint32_t id)
+{
+	static uint32_t logged;
+	uint32_t y0 = 0, y1 = 0;
+
+	if (!fZCActive) {
+		zeroCopyStart();
+	}
+	if (sweet_surface_take_dirty(s, &y0, &y1)) {
+		uintptr_t k = s->kernelAddress();
+		if (k != 0) {
+			sweet_surface_clean(k + (uint64_t)y0 * s->bytesPerRow, (uint64_t)(y1 - y0) * s->bytesPerRow);
+		}
+	}
+	for (uint32_t p = 0; p < 2; p++) {
+		vm_offset_t b = fMdss + S9_VIG(p);
+		s9_wr(b + SSPP_YSTRIDE0, s->bytesPerRow & 0xffff);
+		s9_wr(b + SSPP_SRC0_ADDR, (uint32_t)s->phys);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	s9_wr(fMdss + S9_CTL0_FLUSH, S9_FLUSH_BITS);
+	IOLockLock(fLock);
+	fPendingFlipID = id;
+	IOLockUnlock(fLock);
+	if (logged < 6) {
+		/* Bring-up: how long the SDE takes to apply a flip (expected: up to one frame). */
+		logged++;
+		uint32_t f0 = s9_rd(fMdss + S9_CTL0_FLUSH), f = f0;
+		uint64_t t0 = mach_absolute_time(), ns;
+		for (int i = 0; i < 200 && (f & S9_FLUSH_BITS) != 0; i++) {
+			delay_for_interval_with_leeway(200, 0, kMicrosecondScale);
+			f = s9_rd(fMdss + S9_CTL0_FLUSH);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		IOLog("SWEET FB: flip %u slot %d at 0x%llx, rows %u-%u cleaned, flush 0x%x -> 0x%x after %llu us\n",
+		    id, s->slot, s->phys, y0, y1, f0, f, ns / 1000);
+	}
+}
