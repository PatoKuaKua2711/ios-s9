+static void sweet_surface_init_lock(void);
+
+void
+sweet_surface_set_display_slots(uint64_t phys, uint64_t slotSize, uint32_t count,
+    uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	sweet_surface_init_lock();
+	IOLockLock(sweet_surface_lock);
+	sweet_slot_phys = phys;
+	sweet_slot_size = slotSize;
+	sweet_slot_count = count < SWEET_SURFACE_MAX_SLOTS ? count : SWEET_SURFACE_MAX_SLOTS;
+	sweet_slot_width = width;
+	sweet_slot_height = height;
+	sweet_slot_format = pixelFormat;
+	IOLockUnlock(sweet_surface_lock);
+	IOLog("SWEET SURF: %u display slots of %llu bytes at 0x%llx for %ux%u 0x%x\n",
+	    sweet_slot_count, slotSize, phys, width, height, pixelFormat);
+}
+
+/* A free slot for s (backboardd's framebuffer geometry), or -1. Lock held. */
+static int
+sweet_surface_slot_take_locked(SweetSurface *s)
+{
+	if (s->pixelFormat != sweet_slot_format || s->width != sweet_slot_width ||
+	    s->height != sweet_slot_height || s->planeCount != 0 || s->offset != 0 ||
+	    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    s->allocSize > sweet_slot_size) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < sweet_slot_count; i++) {
+		if (sweet_slot_surface[i] == NULL) {
+			sweet_slot_surface[i] = s;      /* weak: cleared by s->free() */
+			return (int)i;
+		}
+	}
+	return -1;
+}
