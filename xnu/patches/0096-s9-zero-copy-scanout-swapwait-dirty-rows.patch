+/*
+ * SwapWait: until swap id is on screen (zero-copy: the SDE took its flip;
+ * CPU copy: it was copied), at most 50 ms. CoreAnimation passes the id of
+ * the swap that showed its other buffer before drawing into this one again
+ * (IOMFBDisplay::can_update_), so this is what keeps it from drawing into
+ * the buffer the panel is reading, and what paces it to the panel.
+ */
+void
+AppleCLCD::swapWait(uint32_t id, uint64_t flags)
+{
+	static uint32_t logged;
+	uint64_t t0 = mach_absolute_time(), deadline, ns;
+	uint32_t ended, presented, pending;
+	bool timedOut = false;
+
+	clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+	for (;;) {
+		IOLockLock(fLock);
+		if (fPendingFlipID != 0 && zeroCopyLatched()) {
+			if (fPendingFlipID > fPresentedID) {
+				fPresentedID = fPendingFlipID;
+			}
+			fPendingFlipID = 0;
+		}
+		ended = fEndedID;
+		presented = fPresentedID;
+		pending = fPendingFlipID;
+		bool done = id == 0 || fVsync60 || fPowerOff || id > ended || presented >= id;
+		IOLockUnlock(fLock);
+		if (done) {
+			break;
+		}
+		if (mach_absolute_time() >= deadline) {
+			timedOut = true;
+			break;
+		}
+		delay_for_interval_with_leeway(500, 0, kMicrosecondScale);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	OSIncrementAtomic64((volatile SInt64 *)&sweetfb_waits);
+	OSAddAtomic64((SInt64)ns, (volatile SInt64 *)&sweetfb_wait_ns);
+	if (timedOut) {
+		OSIncrementAtomic64((volatile SInt64 *)&sweetfb_wait_timeouts);
+	}
+	if (logged < 24 || (timedOut && logged < 64)) {
+		logged++;
+		IOLog("SWEET FB: SwapWait %u flags 0x%llx: ended %u presented %u pending %u, %llu us%s\n",
+		    id, flags, ended, presented, pending, ns / 1000, timedOut ? " TIMEOUT" : "");
+	}
+}
+
+/* RequestPowerChange: off fades out (vsyncFired), on redraws the latest frame. */
+void
+AppleCLCD::setPower(bool off)
+{
+	IOLockLock(fLock);
+	bool changed = off != fPowerOff;
+	if (changed) {
+		fPowerOff = off;
+		fFadeStep = 0;
+		fDirty = true;
+		fDirtyAll = true;
+		fPresentedID = fEndedID;        /* nothing pending is waited for across the change */
+	}
+	IOLockUnlock(fLock);
+	if (changed && off) {
+		blank();
+	}
+}
+
+/* Display off while zero-copy shows a frame: black panel memory, pipes back on it. */
+void
+AppleCLCD::blank(void)
+{
+	IOLockLock(fShowLock);
+	if (fZCActive) {
+		for (uint32_t y = 0; y < fHeight; y++) {
+			bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)fWidth * 4);
+		}
+		markRows(0, fHeight);
+		cleanRows();
+		zeroCopyStop();
+		fPanelStale = true;
+	}
+	IOLockUnlock(fShowLock);
+}
