+void
+sweet_surface_clean(uintptr_t va, uint64_t len)
+{
+	uintptr_t a = va & ~(uintptr_t)63, end = va + len;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
