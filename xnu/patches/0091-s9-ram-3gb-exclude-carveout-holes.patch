diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..dc5f1b1 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2568,6 +2568,24 @@ pmap_virtual_region(
 static unsigned int avail_page_count = 0;
 static bool need_ram_ranges_init = true;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Galaxy S9: XNU manages the DRAM span [gPhysBase, avail_end) as one block,
+ * but two Qualcomm carveouts sit inside it -- the IPA firmware image and the
+ * SPSS secure region. Exclude their pages from the free list so XNU never
+ * allocates them (the physmap still covers them, unused). These regions were
+ * verified to be unused, writable RAM's *neighbours* by shim M8; the holes
+ * themselves are the fixed reserved-memory ranges of the SDM845/starqlte DT.
+ * gPhysBase is 0xa1800000 (see tools/mkadt.py).
+ */
+static const struct { pmap_paddr_t start, end; } sweet_ram_holes[] = {
+	{ 0xc0000000ULL, 0xd4000000ULL },       /* ipa_fw_ld_region, 320 MiB */
+	{ 0xff000000ULL, 0x100000000ULL },      /* pil_spss_region, 16 MiB */
+};
+#define SWEET_RAM_NHOLES (sizeof(sweet_ram_holes) / sizeof(sweet_ram_holes[0]))
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 
 /**
  * Checks to see if a given page is in
@@ -2578,6 +2596,17 @@ static bool need_ram_ranges_init = true;
 bool
 pmap_is_bad_ram(__unused ppnum_t ppn)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* Galaxy S9: the two Qualcomm carveouts inside our DRAM span are "bad RAM"
+	 * for allocation -- their vm_page stays in the (contiguous) array but is
+	 * never released to the free list. Called from pmap_startup. */
+	pmap_paddr_t pa = ptoa_64(ppn);
+	for (unsigned i = 0; i < SWEET_RAM_NHOLES; i++) {
+		if (pa >= sweet_ram_holes[i].start && pa < sweet_ram_holes[i].end) {
+			return true;
+		}
+	}
+#endif
 	return false;
 }
 
@@ -2641,7 +2670,6 @@ pmap_next_page(
 		initialize_ram_ranges();
 	}
 
-
 	if (first_avail != avail_end) {
 		*pnum = (ppnum_t)atop(first_avail);
 		first_avail += PAGE_SIZE;
